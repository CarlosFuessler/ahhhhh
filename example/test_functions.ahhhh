fn greet(name: string) {
    print("Hello, ", name, "!")
}

fn factorial(n: f64) f64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn is_even(n: f64) bool {
    // Wir haben kein % im Compiler? Lass uns nachsehen.
    // Ich habe vorhin OP_MOD in vm.c gesehen.
    return (n % 2) == 0
}
