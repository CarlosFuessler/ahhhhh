fn main() {
    var win = window_create(800, 600, "Pong in Ahhhh!")
    
    var ball_x = 400.0
    var ball_y = 300.0
    var ball_dx = 5.0
    var ball_dy = 5.0
    
    var paddle_y = 250.0
    var paddle_h = 100.0
    var paddle_w = 20.0
    
    // raylib-tasten: w = 87, s = 83
    var KEY_W = 87
    var KEY_S = 83

    while !window_should_close(win) {
        // Paddle-Steuerung
        if is_key_down(KEY_W) { paddle_y = paddle_y - 6 }
        if is_key_down(KEY_S) { paddle_y = paddle_y + 6 }
        
        // Paddle auf dem Bildschirm halten
        if paddle_y < 0 { paddle_y = 0 }
        if paddle_y > 500 { paddle_y = 500 }
        
        // Ballphysik
        ball_x = ball_x + ball_dx
        ball_y = ball_y + ball_dy
        
        // Wandabprall oben unten
        if ball_y < 10 { ball_dy = abs(ball_dy) }
        if ball_y > 590 { ball_dy = -abs(ball_dy) }
        
        // Wandabprall rechts
        if ball_x > 790 { ball_dx = -abs(ball_dx) }
        
        // Paddle-Kollision
        if ball_x < 30 {
            if ball_y > paddle_y {
                if ball_y < paddle_y + paddle_h {
                    ball_dx = abs(ball_dx)
                }
            }
        }
        
        // Ball zurücksetzen, wenn er vorbei ist
        if ball_x < 0 {
            ball_x = 400.0
            ball_y = 300.0
            ball_dx = 5.0
            ball_dy = (rand_range(-3, 3) * 2)
            if ball_dy == 0 { ball_dy = 4.0 }
        }
        
        begin_draw(win)
        clear_background(win, 20, 20, 20, 255)
        
        // Mittellinie zeichnen
        draw_line(win, 400, 0, 400, 600, 50, 50, 50, 255)
        
        // Paddle zeichnen
        draw_rectangle(win, 10, paddle_y, paddle_w, paddle_h, 255, 255, 255, 255)
        
        // Ball zeichnen
        draw_circle(win, ball_x, ball_y, 10, 255, 255, 0, 255)
        
        // Steuerung anzeigen
        draw_text(win, "W/S für hoch und runter", 50, 20, 20, 150, 150, 150, 255)
        
        end_draw(win)
    }
    
    window_close(win)
}

main()
