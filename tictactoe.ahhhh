fn draw_board(win: f64, board: []f64) {
    // Draw centered grid lines (X: 250..550, Y: 150..450)
    // Vertical lines
    draw_line(win, 350, 150, 350, 450, 150, 150, 200, 255)
    draw_line(win, 450, 150, 450, 450, 150, 150, 200, 255)
    // Horizontal lines
    draw_line(win, 250, 250, 550, 250, 150, 150, 200, 255)
    draw_line(win, 250, 350, 550, 350, 150, 150, 200, 255)
    
    // Draw board symbols
    for row in 0..3 {
        for col in 0..3 {
            var cell_idx = row * 3 + col
            var symbol = board[cell_idx]
            
            // Cell center coordinates
            var cx = 300 + col * 100
            var cy = 200 + row * 100
            
            if symbol == 1 {
                // Draw Player 'X' using clean crossed diagonal lines
                draw_line(win, cx - 25, cy - 25, cx + 25, cy + 25, 0, 180, 255, 255)
                draw_line(win, cx + 25, cy - 25, cx - 25, cy + 25, 0, 180, 255, 255)
            }
            if symbol == 2 {
                // Draw AI 'O' using nested solid circles to form hollow ring
                draw_circle(win, cx, cy, 30, 255, 100, 100, 255)
                draw_circle(win, cx, cy, 25, 30, 30, 40, 255)
            }
        }
    }
}

fn draw_selector(win: f64, cursor_x: f64, cursor_y: f64) {
    var cursor_screen_x = 250 + cursor_x * 100
    var cursor_screen_y = 150 + cursor_y * 100
    
    // Draw outer border outlines for selector
    draw_rectangle(win, cursor_screen_x, cursor_screen_y, 100, 8, 255, 255, 255, 150)
    draw_rectangle(win, cursor_screen_x, cursor_screen_y + 92, 100, 8, 255, 255, 255, 150)
    draw_rectangle(win, cursor_screen_x, cursor_screen_y, 8, 100, 255, 255, 255, 150)
    draw_rectangle(win, cursor_screen_x + 92, cursor_screen_y, 8, 100, 255, 255, 255, 150)
}

fn check_win_for_player(board: []f64, player: f64) bool {
    // Check rows
    if board[0] == player { if board[1] == player { if board[2] == player { return true } } }
    if board[3] == player { if board[4] == player { if board[5] == player { return true } } }
    if board[6] == player { if board[7] == player { if board[8] == player { return true } } }
    // Check cols
    if board[0] == player { if board[3] == player { if board[6] == player { return true } } }
    if board[1] == player { if board[4] == player { if board[7] == player { return true } } }
    if board[2] == player { if board[5] == player { if board[8] == player { return true } } }
    // Check diags
    if board[0] == player { if board[4] == player { if board[8] == player { return true } } }
    if board[2] == player { if board[4] == player { if board[6] == player { return true } } }
    return false
}

fn check_draw(board: []f64) bool {
    for i in 0..9 {
        if board[i] == 0 { return false }
    }
    return true
}

fn ai_find_move(board: []f64) f64 {
    var res: f64 = -1
    
    // 1. Try to win in next move
    for i in 0..9 {
        if board[i] == 0 {
            board[i] = 2
            var win = check_win_for_player(board, 2)
            board[i] = 0
            if win {
                res = i
                return res
            }
        }
    }
    
    // 2. Try to block Player from winning
    for i in 0..9 {
        if board[i] == 0 {
            board[i] = 1
            var win = check_win_for_player(board, 1)
            board[i] = 0
            if win {
                res = i
                return res
            }
        }
    }
    
    // 3. Take center if open
    if board[4] == 0 { return 4 }
    
    // 4. Take random open cell
    while true {
        var r_idx = rand_range(0, 9)
        var idx = floor(r_idx)
        if idx >= 0 {
            if idx < 9 {
                if board[idx] == 0 {
                    res = idx
                    return res
                }
            }
        }
    }
    return res
}

fn main() {
    var win: f64 = window_create(800, 600, "ahhhhh Tic Tac Toe")
    
    var KEY_W = 87
    var KEY_A = 65
    var KEY_S = 83
    var KEY_D = 68
    var KEY_UP = 265
    var KEY_LEFT = 263
    var KEY_DOWN = 264
    var KEY_RIGHT = 262
    var KEY_SPACE = 32
    var KEY_ENTER = 257
    var KEY_R = 82
    
    var board: []f64 = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    var cursor_x = 1
    var cursor_y = 1
    var game_state = 0
    
    while !window_should_close(win) {
        if game_state == 0 {
            // Move cursor
            if is_key_pressed(win, KEY_W) { cursor_y = cursor_y - 1 }
            if is_key_pressed(win, KEY_UP) { cursor_y = cursor_y - 1 }
            if is_key_pressed(win, KEY_S) { cursor_y = cursor_y + 1 }
            if is_key_pressed(win, KEY_DOWN) { cursor_y = cursor_y + 1 }
            if is_key_pressed(win, KEY_A) { cursor_x = cursor_x - 1 }
            if is_key_pressed(win, KEY_LEFT) { cursor_x = cursor_x - 1 }
            if is_key_pressed(win, KEY_D) { cursor_x = cursor_x + 1 }
            if is_key_pressed(win, KEY_RIGHT) { cursor_x = cursor_x + 1 }
            
            // Constrain cursor
            if cursor_x < 0 { cursor_x = 0 }
            if cursor_x > 2 { cursor_x = 2 }
            if cursor_y < 0 { cursor_y = 0 }
            if cursor_y > 2 { cursor_y = 2 }
            
            var action = false
            if is_key_pressed(win, KEY_SPACE) { action = true }
            if is_key_pressed(win, KEY_ENTER) { action = true }
            
            if action {
                var idx = cursor_y * 3 + cursor_x
                if board[idx] == 0 {
                    board[idx] = 1
                    
                    if check_win_for_player(board, 1) {
                        game_state = 2
                    } else {
                        if check_draw(board) {
                            game_state = 4
                        } else {
                            game_state = 1
                        }
                    }
                }
            }
        }
        
        if game_state == 1 {
            var ai_move = ai_find_move(board)
            if ai_move >= 0 {
                board[ai_move] = 2
                if check_win_for_player(board, 2) {
                    game_state = 3
                } else {
                    if check_draw(board) {
                        game_state = 4
                    } else {
                        game_state = 0
                    }
                }
            }
        }
        
        if game_state > 1 {
            if is_key_pressed(win, KEY_R) {
                for i in 0..9 { board[i] = 0 }
                game_state = 0
            }
        }
        
        begin_draw(win)
        clear_background(win, 30, 30, 40, 255)
        
        draw_text(win, "ahhhhh Tic Tac Toe", 220, 20, 40, 255, 255, 255, 255)
        
        if game_state == 0 {
            draw_text(win, "Your Turn (X) - Navigate with WASD / Arrows, Space to Place", 130, 80, 20, 100, 200, 255, 255)
        }
        if game_state == 1 {
            draw_text(win, "AI is thinking...", 320, 80, 20, 255, 255, 150, 255)
        }
        if game_state == 2 {
            draw_text(win, "CONGRATULATIONS! You Won! Press R to Restart", 170, 80, 22, 100, 255, 100, 255)
        }
        if game_state == 3 {
            draw_text(win, "GAME OVER! AI Won! Press R to Restart", 200, 80, 22, 255, 100, 100, 255)
        }
        if game_state == 4 {
            draw_text(win, "IT'S A DRAW! Press R to Restart", 230, 80, 22, 200, 200, 200, 255)
        }
        
        draw_board(win, board)
        
        if game_state == 0 {
            draw_selector(win, cursor_x, cursor_y)
        }
        
        end_draw(win)
    }
    
    window_close(win)
}

main()
