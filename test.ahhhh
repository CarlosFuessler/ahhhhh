


fn main(){
    for i in 0..10 {
        print("i = ", i, .red)
    }
    snake_case_example()

}

fn snake_case_example() {
    print("Hello from snake_case_example!", .green)
} 




    // 1. PascalCase für eigene Datentypen (Structs)
    struct Point {
        x: f64,
        y: f64
    }

    // 2. snake_case für Funktionen & statische Typisierung
    fn distance_from_origin(p: Point) f64 {
        return sqrt(p.x * p.x + p.y * p.y) // eingebaute Math
    }

    fn main() {
        var p = Point{ x: 3.0, y: 4.0 }   // 3. Typinferenz bei 'var'
        var dist = distance_from_origin(p)

        // 4. Farbige Konsolenausgabe
        print("Punkt: (", p.x, ", ", p.y, ")", .cyan)
        print("Entfernung zum Ursprung: ", dist, .green)
    }

    main() // Keine Semikolons erforderlich








